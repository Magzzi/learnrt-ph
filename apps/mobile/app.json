{
  "expo": {
    "name": "LearnRT",
    "slug": "learnrt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.learnrt.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a1a1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.learnrt.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LearnRT uses your location to find the Nearest Station and to follow your Guided Ride.",
          "locationAlwaysAndWhenInUsePermission": "During a Guided Ride, LearnRT watches only the Station areas on your route so it can tell you when to get off while your phone is locked. Your location never leaves your phone.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#34d399"
        }
      ],
      "expo-dev-client",
      "@maplibre/maplibre-react-native"
    ],
    "scheme": "learnrt",
    "backgroundColor": "#0a1a1a",
    "experiments": {
      "typedRoutes": true
    }
  }
}
